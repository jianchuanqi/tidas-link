{
  "binding": "PACT",
  "version": "3.0.3",
  "definitions": {
    "lca-result": "The field has LCA-result meaning and is mapped to TIDAS Link.",
    "pact-binding": "The field is required to preserve or reproduce the PACT representation but is not part of the TIDAS Link LCA result.",
    "system-transfer": "The field belongs to transport execution or an ordinary host information system."
  },
  "systemTransferFields": [
    "OAuth2 client credentials and access tokens",
    "HTTP method, path, headers, and response status",
    "filter expressions, result limit, and pagination links",
    "CloudEvent id, source, type, time, and correlation",
    "request delivery status, retry state, and error response",
    "sender and recipient endpoints",
    "authorization, encryption, storage, and audit fields"
  ],
