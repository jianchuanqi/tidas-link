{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tidas.tiangong.earth/schemas/calculation-input.json",
  "title": "TIDAS Link Calculation Input",
  "description": "An upstream result or dataset that was actually used in an LCA result calculation. The target is the LCA result containing this input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputId",
    "sourceType",
    "usedQuantity",
    "calculationPosition"
  ],
  "properties": {
    "inputId": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "supplier-specific",
        "supplier-average",
        "proxy",
        "background"
      ]
    },
    "sourceResult": {
      "$ref": "https://tidas.tiangong.earth/schemas/common.json#/$defs/ResultReference"
    },
    "sourceDataset": {
      "$ref": "https://tidas.tiangong.earth/schemas/common.json#/$defs/TidasObjectReference"
    },
    "usedQuantity": {
      "$ref": "https://tidas.tiangong.earth/schemas/common.json#/$defs/Quantity"
    },
    "conversionDescription": {
      "type": "string"
    },
    "calculationPosition": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "properties": {
        "sourceResult": {}
      },
      "required": [
        "sourceResult"
      ]
    },
    {
      "properties": {
        "sourceDataset": {}
      },
      "required": [
        "sourceDataset"
      ]
    }
  ]
}
