{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tidas.tiangong.earth/schemas/tidas_link_lcia_extension_v0_1.json",
  "title": "TIDAS Link LCIA Extension v0.1",
  "description": "A compact LCIA result extension for TIDAS Link. It carries selected impact assessment results and evidence references without disclosing full life cycle inventory exchanges.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "impactResults"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "TIDAS-Link-LCIA-0.1"
    },
    "declaredUnitRef": {
      "type": "string",
      "description": "Reference to the declared unit used by the enclosing TIDAS-Link-PCF payload."
    },
    "calculationBoundary": {
      "type": "string",
      "description": "Short statement of the LCIA boundary, such as cradle-to-gate, cradle-to-grave, battery-regulation, or declared lifecycle modules."
    },
    "impactResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ImpactResult"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced implementation extensions. Keys SHOULD be DNS names or stable project namespaces.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Decimal": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "tidas-process",
            "tidas-lcia-method",
            "tidas-source",
            "ilcd",
            "openepd",
            "ecospold2",
            "epd",
            "study",
            "verification-report",
            "credential",
            "uri",
            "other"
          ]
        },
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "access": {
          "type": "string",
          "enum": [
            "public",
            "restricted",
            "confidential",
            "regulator-only",
            "internal"
          ]
        }
      }
    },
    "DataQuality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryDataShare": {
          "$ref": "#/$defs/Decimal",
          "description": "Primary data share in percent, 0..100."
        },
        "technologicalDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "geographicalDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "temporalDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "completenessDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "reliabilityDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "dataQualityDescription": {
          "type": "string"
        }
      }
    },
    "Uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "type": "string",
          "enum": [
            "none",
            "normal",
            "lognormal",
            "triangular",
            "uniform",
            "qualitative",
            "other"
          ]
        },
        "relativeStandardDeviation": {
          "$ref": "#/$defs/Decimal"
        },
        "lower95": {
          "$ref": "#/$defs/Decimal"
        },
        "upper95": {
          "$ref": "#/$defs/Decimal"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ImpactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impactCategory",
        "indicator",
        "method",
        "value",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "impactCategory": {
          "type": "string",
          "description": "Impact category, e.g. climate change, acidification, eutrophication, water use, resource use, particulate matter."
        },
        "indicator": {
          "type": "string",
          "description": "Impact indicator name, e.g. GWP total, AP, EP freshwater, WDP, PM."
        },
        "method": {
          "type": "string",
          "description": "LCIA method family, e.g. EF 3.1, IPCC AR6, EN 15804+A2, ReCiPe 2016, TRACI 2.1."
        },
        "methodVersion": {
          "type": "string"
        },
        "resultType": {
          "type": "string",
          "enum": [
            "midpoint",
            "endpoint",
            "inventory-derived",
            "single-score",
            "other"
          ],
          "default": "midpoint"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "type": "string",
          "description": "Unit of the impact result, e.g. kg CO2e, mol H+ eq, kg PO4 eq, m3 depriv."
        },
        "lifeCycleStage": {
          "type": "string",
          "description": "Named lifecycle stage, such as RawMaterialExtraction, MainProduction, Distribution, Recycling, production, packaging, outbound-logistics."
        },
        "module": {
          "type": "string",
          "description": "Module code if applicable, e.g. A1-A3, A4, C3, D."
        },
        "boundaryRef": {
          "type": "string"
        },
        "tidasMethodRef": {
          "$ref": "#/$defs/Reference"
        },
        "tidasProcessRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "comment": {
          "type": "string"
        }
      }
    }
  }
}
