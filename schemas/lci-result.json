  "title": "TIDAS Link LCI Result",
  "description": "Inventory-flow result exchanged through TIDAS Link.",
  "allOf": [
    {
      "$ref": "https://tidas.tiangong.earth/schemas/lca-result.json"
    },
    {
      "type": "object",
      "properties": {
        "resultType": {
          "const": "lci"
        },
