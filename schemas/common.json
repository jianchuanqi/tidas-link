{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tidas.tiangong.earth/schemas/common.json",
  "title": "TIDAS Link Common Types",
  "description": "Shared LCA structures used by the TIDAS Link result schemas.",
  "$defs": {
    "ResultReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "resultVersion"
      ],
      "properties": {
        "resultId": {
          "type": "string",
          "minLength": 1
        },
        "resultVersion": {
          "type": "string",
          "minLength": 1
        },
        "resultItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "unit"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Decimal": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "NonNegativeDecimal": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "PositiveDecimal": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?=.*[1-9])[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "DataOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ids"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "product",
            "material",
            "component",
            "batch",
            "facility-output",
            "service",
            "other"
          ]
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "granularity": {
          "type": "string",
          "enum": [
            "unspecified",
            "product-model",
            "product-variant",
            "batch",
            "serial-item",
            "facility-period",
            "shipment",
            "other"
          ]
        }
      }
    },
    "ReferenceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "amount",
        "unit"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "declared-unit",
            "functional-unit",
            "reference-flow",
            "other"
          ]
        },
        "amount": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "massKg": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "referenceFlow": {
          "$ref": "#/$defs/TidasObjectReference"
        },
        "conversionDescription": {
          "type": "string"
        }
      }
    },
    "SystemBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "gate-to-gate",
            "cradle-to-gate",
            "cradle-to-grave",
            "cradle-to-cradle",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "includedStages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludedStages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Geography": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "regionOrSubregion": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 2
        },
        "countrySubdivision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Modeling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "productOrSectorRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductRule"
          }
        },
        "allocationRulesDescription": {
          "type": "string"
        },
        "cutOffRulesDescription": {
          "type": "string"
        },
        "excludedSharePercent": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "secondaryDataSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecondaryDataSource"
          }
        }
      }
    },
    "ImpactMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "$ref": "#/$defs/TidasObjectReference"
        }
      }
    },
    "InventoryFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "flow"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output"
          ]
        },
        "flow": {
          "$ref": "#/$defs/TidasObjectReference"
        }
      }
    },
    "TidasObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "description": "Minimal identity reference to an object governed by TIDAS. TIDAS Link does not define, retrieve, or assess the referenced dataset.",
      "required": [
        "objectType",
        "id"
      ],
      "properties": {
        "objectType": {
          "type": "string",
          "enum": [
            "process",
            "flow",
            "source",
            "unit-group",
            "lcia-method",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DataQuality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryDataShare": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "technologicalDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "geographicalDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "temporalDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "completenessDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "reliabilityDQR": {
          "$ref": "#/$defs/Decimal"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-verified",
            "first-party",
            "second-party",
            "third-party"
          ]
        },
        "coverage": {
          "type": "string"
        },
        "providerName": {
          "type": "string"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "standardName": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        }
      }
    },
    "Uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "type": "string"
        },
        "relativeStandardDeviation": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "lowerBound": {
          "$ref": "#/$defs/Decimal"
        },
        "upperBound": {
          "$ref": "#/$defs/Decimal"
        },
        "confidenceLevelPercent": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "LcaExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        },
        "dataSchema": {
          "type": "string",
          "format": "uri"
        },
        "documentation": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "InventoryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultItemId",
        "value",
        "unit",
        "inventoryFlow"
      ],
      "properties": {
        "resultItemId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "inventoryFlow": {
          "$ref": "#/$defs/InventoryFlow"
        },
        "lifeCycleStage": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      },
      "title": "LCI result item"
    },
    "ImpactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultItemId",
        "impactCategory",
        "indicator",
        "value",
        "unit",
        "method"
      ],
      "properties": {
        "resultItemId": {
          "type": "string",
          "minLength": 1
        },
        "impactCategory": {
          "type": "string",
          "minLength": 1
        },
        "indicator": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "$ref": "#/$defs/ImpactMethod"
        },
        "lifeCycleStage": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      },
      "title": "LCIA result item"
    },
    "ReportedParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultItemId",
        "indicator",
        "value",
        "unit"
      ],
      "properties": {
        "resultItemId": {
          "type": "string",
          "minLength": 1
        },
        "indicator": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "lifeCycleStage": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "dataQuality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      },
      "title": "Reported LCA parameter"
    },
    "ProductRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleNames"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "ruleNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "otherOperatorName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SecondaryDataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "$ref": "#/$defs/TidasObjectReference"
        }
      }
    }
  }
}
